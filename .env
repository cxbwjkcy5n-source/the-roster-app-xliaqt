
# Supabase Configuration
# Get these values from your Supabase project dashboard
# Project Settings -> API -> Project URL and anon/public key

# REQUIRED: Your Supabase project URL (e.g., https://xxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED: Your Supabase anon/public key (starts with eyJ...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend URL (already configured)
EXPO_PUBLIC_BACKEND_URL=https://e5t37cpd78kyyr4rpqkxse5t4eh3mvw3.app.specular.dev

# IMPORTANT STEPS:
# 1. Go to https://app.supabase.com/project/_/settings/api
# 2. Copy your "Project URL" and replace the EXPO_PUBLIC_SUPABASE_URL value above
# 3. Copy your "anon public" key and replace the EXPO_PUBLIC_SUPABASE_ANON_KEY value above
# 4. Save this file
# 5. Restart the Expo dev server (stop and run 'npm run dev' again)
