
# Supabase Configuration
# Get these values from your Supabase project dashboard
# Project Settings -> API

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (starts with eyJ...)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend URL (already configured)
EXPO_PUBLIC_BACKEND_URL=https://e5t37cpd78kyyr4rpqkxse5t4eh3mvw3.app.specular.dev

# Note: After adding your values, you can optionally use these environment variables
# instead of hardcoding them in app.json. The app will check both locations.
