
# Supabase Configuration
# Get these values from your Supabase project dashboard
# Project Settings -> API

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
# REQUIRED: Must be a valid HTTPS URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (starts with eyJ...)
# REQUIRED: Get this from Supabase dashboard
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend URL (already configured)
EXPO_PUBLIC_BACKEND_URL=https://e5t37cpd78kyyr4rpqkxse5t4eh3mvw3.app.specular.dev

# IMPORTANT: 
# 1. Create a .env file in the root directory with your actual values
# 2. Environment variables with EXPO_PUBLIC_ prefix are automatically available in your app
# 3. Restart the Expo dev server after changing environment variables
